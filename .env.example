# Client / Frontend Server Connection:
# Default server URL or IP for nmessenger-client (desktop and Android APK builds)
# Examples: http://192.168.1.16:18087, 192.168.1.16, or https://messenger.example.com
SERVER_URL=http://192.168.1.16:18087

POSTGRES_PASSWORD=nmessenger_dev
POSTGRES_PORT=54329
REDIS_PORT=63799
API_BIND=127.0.0.1
API_PORT=18087
RUST_LOG=nm_servo=info,actix_web=info

# To run the server on the host after starting PostgreSQL and Redis:
DATABASE_URL=postgres://nmessenger:nmessenger_dev@127.0.0.1:54329/nmessenger
REDIS_URL=redis://127.0.0.1:63799/0
BIND_ADDR=127.0.0.1:18087
UPLOAD_DIR=data/uploads

NM_TEST_POSTGRES_PORT=55439
NM_TEST_REDIS_PORT=56379
## Optional per-account upload storage quota (default: 512 MiB).
USER_UPLOAD_QUOTA_BYTES=536870912

## GitHub release webhook secret (at least 32 characters; configure the same secret on GitHub).
# GITHUB_WEBHOOK_SECRET=

## Production override (compose.production.yaml): set real secrets and a DNS hostname.
# NM_DOMAIN=messenger.example.com
# REDIS_PASSWORD=replace-with-a-long-random-secret
